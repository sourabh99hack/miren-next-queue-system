* {
    box-sizing: border-box;
}

/* Display Themes */


/* body {
    margin: 0;
    padding: 0;

    background: #050909;

    color: white;

    font-family:
        Arial,
        Helvetica,
        sans-serif;
} */

body {
    --display-background: #ffffff;
    --display-text: #111111;
    --display-secondary-text: #666666;

    margin: 0;
    padding: 0;

    background: var(--display-background);
    color: var(--display-text);

    font-family:
        Arial,
        Helvetica,
        sans-serif;
}

body[data-theme="dark"] {
    --display-background: #111111;
    --display-text: #ffffff;
    --display-secondary-text: #cccccc;
}

body[data-theme="light"] {
    --display-background: #ffffff;
    --display-text: #111111;
    --display-secondary-text: #666666;
}

.store-name {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 25px;
    letter-spacing: 1px;
}

/* .display-container {
    width: 100vw;
    height: 100vh;

    display: flex;

    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 40px;
    background: var(--display-background);
    color: var(--display-text);
} */

.display-container {
    width: 100vw;
    height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 3vh 4vw;

    background: var(--display-background);
    color: var(--display-text);

    overflow: hidden;
}


.hidden {
    display: none !important;
}

/* =========================
   DISPLAY SCREEN LAYOUT
   ========================= */

#idle-screen,
#call-screen,
#queue-screen {
    width: 90vw;
    min-height: 82vh;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    text-align: center;

    gap: 1.2vh;
}

/* =========================
   IDLE SCREEN
   ========================= */

.welcome {
    font-size: 70px;

    font-weight: bold;

    margin-bottom: 50px;
}


.next-cashier {
    font-size: clamp(42px, 4.5vw, 82px);

    font-weight: bold;

    margin-bottom: 1vh;

    letter-spacing: 1px;
}


.wait-message {
    font-size: 32px;

    margin-bottom: 50px;
}


.thank-you {
    font-size: clamp(22px, 2vw, 40px);

    margin-top: 1vh;
}


/* =========================
   CURRENT REGISTER
   ========================= */

.proceed-message {
    font-size: clamp(28px, 2.8vw, 52px);

    margin-bottom: 0.5vh;
}


.register-box {
    display: flex;

    width: min(82vw, 1500px);

    min-height: 12vh;

    justify-content: center;
    align-items: center;

    background: #16d34a;

    color: black;

    font-size: clamp(48px, 6vw, 110px);

    font-weight: bold;

    padding: 2vh 3vw;

    margin: 1vh 0;

    border-radius: 16px;

    box-shadow:
        0 0 25px rgba(22, 211, 74, 0.5);

    text-align: center;

    line-height: 1.1;
}


/* =========================
   TIMER
   ========================= */

.timer {
    margin-top: 1vh;

    font-size: clamp(38px, 4vw, 72px);

    font-weight: bold;

    line-height: 1;
}


.timer::after {
    content: " seconds";

    font-size: 0.4em;

    font-weight: normal;
}

/* =========================
   QUEUE MODE
   ========================= */

.now-calling {
    font-size: clamp(42px, 4.5vw, 82px);

    font-weight: bold;

    margin-bottom: 1vh;
}


.next-box {
    display: flex;

    width: min(75vw, 1300px);

    justify-content: center;
    align-items: center;

    margin: 1vh auto 0;

    background: #2563eb;

    color: white;

    font-size: clamp(32px, 4vw, 70px);

    font-weight: bold;

    padding: 2vh 3vw;

    border-radius: 14px;

    text-align: center;
}


.queue-message {
    font-size: clamp(24px, 2.5vw, 46px);

    margin-top: 1vh;
}


/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 900px) {

    #idle-screen,
    #call-screen,
    #queue-screen {
        width: 92vw;
        min-height: 80vh;

        gap: 1vh;
    }

    .store-logo {
        max-width: 45vw;
        max-height: 16vh;
    }

    .register-box {
        width: 90vw;

        font-size: clamp(38px, 6vw, 65px);

        padding: 2vh 3vw;

        white-space: normal;
    }

    .next-box {
        width: 88vw;

        font-size: clamp(28px, 4vw, 50px);
    }
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 600px) {

    .display-container {
        padding: 20px;
    }


    .welcome {
        font-size: 38px;
    }


    .next-cashier {
        font-size: 32px;
    }


    .wait-message {
        font-size: 20px;
    }


    .proceed-message {
        font-size: 22px;
    }


    .register-box {
        font-size: 38px;

        padding: 18px 25px;
    }


    .timer {
        font-size: 40px;
    }


    .timer::after {
        font-size: 20px;
    }


    .now-calling {
        font-size: 32px;
    }


    .next-box {
        font-size: 28px;

        padding: 15px 25px;
    }


    .queue-message {
        font-size: 22px;
    }

}

.store-logo {
    width: auto;
    max-width: 32vw;
    max-height: 20vh;
    object-fit: contain;
    margin: 0 auto 1vh;
    display: block;
}

/* Footer Personal branding */

.product-branding {
    position: fixed;

    bottom: 15px;
    left: 0;
    right: 0;

    text-align: center;

    font-size: 14px;

    opacity: 0.65;

    letter-spacing: 0.5px;
}

.product-branding .product-name {
    font-weight: bold;
}

.product-branding .branding-separator {
    margin: 0 6px;
    opacity: 0.7;
}

.product-branding .powered-by {
    font-weight: normal;
}

.product-branding .copyright {
    margin-top: 4px;
    font-size: 11px;
    opacity: 0.7;
}



/* simulator css */

.simulator {
    max-width: 1000px;

    margin: 0 auto;

    padding: 50px;

    text-align: center;
}


.simulator h1 {
    font-size: 50px;
}


.simulator p {
    font-size: 22px;
}


.register-buttons {

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 25px;

    margin-top: 40px;
}


.register-buttons button {

    padding: 35px;

    border: none;

    border-radius: 15px;

    background: #09b83e;

    color: white;

    font-size: 28px;

    font-weight: bold;

    cursor: pointer;
}


.register-buttons button:hover {

    background: #0bd94b;

}


.register-buttons span {

    display: block;

    margin-top: 10px;

    font-size: 16px;
}


.simulator-actions {

    display: flex;

    justify-content: center;

    gap: 20px;

    margin-top: 40px;
}


.simulator-actions button {

    padding: 15px 30px;

    border: 2px solid white;

    border-radius: 10px;

    background: transparent;

    color: white;

    font-size: 18px;

    cursor: pointer;
}


#status {

    margin-top: 40px;

    padding: 20px;

    border: 1px solid #555;

    border-radius: 10px;

    font-size: 20px;
}


@media (max-width: 700px) {

    .register-buttons {

        grid-template-columns: 1fr;

    }

}


/* =========================
   DIGITAL SIGNAGE / ADS
   ========================= */

#ad-screen {
    position: fixed;

    top: 0;
    left: 0;

    width: 100vw;
    height: 100vh;

    background: #000;

    display: flex;

    justify-content: center;
    align-items: center;

    z-index: 9999;
}


#ad-image {
    width: 100%;
    height: 100%;

    object-fit: contain;

    display: block;
}